{
  "name": "owflow",
  "version": "0.7.0",
  "description": "Spec-driven development AI workflow for OpenCode",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run type-check && bun run test && bun run copy-markdowns",
    "copy-markdowns": "bun run ./scripts/copy-markdowns.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:file": "eslint",
    "local-install": "bun run build && opencode plugin \"$(pwd)\" --global --force",
    "prepack": "bun run build",
    "prettify": "prettier --write .",
    "test": "bun test src",
    "type-check": "bun tsc"
  },
  "keywords": [
    "opencode",
    "plugin",
    "workflow",
    "spec-driven",
    "development"
  ],
  "author": {
    "name": "Dawid Paluchowski",
    "email": "palucdev@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palucdev/owflow.git"
  },
  "homepage": "https://github.com/palucdev/owflow#readme",
  "bugs": {
    "url": "https://github.com/palucdev/owflow/issues"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.4",
    "gray-matter": "^4.0.3",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.13",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  }
}
