{
  "name": "owflow",
  "version": "0.2.0",
  "description": "Spec-driven development AI workflow for OpenCode",
  "type": "module",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && bun run copy-markdowns",
    "copy-markdowns": "bun run ./scripts/copy-markdowns.js",
    "local-install": "bun run build && opencode plugin \"$(pwd)\" --global --force",
    "prepack": "bun run build",
    "test": "bun test"
  },
  "keywords": [
    "opencode",
    "plugin",
    "workflow",
    "spec-driven",
    "development"
  ],
  "author": {
    "name": "Dawid Paluchowski",
    "email": "palucdev@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.4",
    "gray-matter": "^4.0.3",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": "^25"
  }
}
